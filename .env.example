# ─── Connector ────────────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL of the connector (Shopify and Jewely send their webhooks here)
PUBLIC_URL=https://sync.helenajoy.example
DATA_DIR=./data
# Keep true until the go-live checklist is done: reads are real, writes are only logged
DRY_RUN=true
# Bearer token for the /admin/* routes (generate with: openssl rand -hex 32)
ADMIN_TOKEN=
LOG_LEVEL=info
# Shopify SKU -> Jewely ref table. Pre-filled by `npm run build-mapping`, editable by hand (status "manuel").
MAPPING_FILE=./mapping.csv

# ─── Jewely ERP ───────────────────────────────────────────────────────────────
JEWELY_BASE_URL=https://helena-joy-quhc2l.jewely.fr/api/v1
# Option A: a token issued by Jewely for the API account
JEWELY_API_TOKEN=
# Option B: a dedicated API account (role with the "Accès API" permission, ideally without 2FA)
JEWELY_IDENTIFIER=
JEWELY_PASSWORD=
# Only if that account has 2FA: the TOTP secret (base32)
JEWELY_TOTP_SECRET=
# Random secret added to the Jewely webhook URLs (openssl rand -hex 24)
JEWELY_WEBHOOK_URL_TOKEN=

# IDs below come from `npm run discover`
# Sale point the web sales are booked on ("Boutique Web" or the main shop)
JEWELY_WEB_SALE_POINT_ID=
# Sale points whose stock is sellable online (comma separated, empty = all)
JEWELY_STOCK_SALE_POINT_IDS=
# Employee the web sales are recorded under (e.g. a "Site web" employee)
JEWELY_OPERATOR_ID=
# customer_order = every web order line linked to Jewely becomes a "commande client" (made-to-order shop, recommended)
# stock_first = pieces in stock are sold first (POST /sales), the rest becomes a commande client
JEWELY_ORDER_MODE=customer_order
# on_hold = draft sale the shop finalises (recommended) | processed = invoice issued immediately (stock_first only)
JEWELY_SALE_STATUS=on_hold
# Payment option used to record the Shopify payment as a deposit (empty = no payment recorded)
JEWELY_PAYMENT_OPTION_ID=
# Roles notified in the ERP (new web order, failure, cancellation)
JEWELY_NOTIFY_ROLES=Admin,Super Admin
JEWELY_SHIPPING_PROVISION_NAME=Livraison
# VAT rate used to turn TTC into HT for customer orders (commandes client)
JEWELY_VAT_RATE=0.20
# Minimum delay between two calls to the ERP (ms)
JEWELY_MIN_INTERVAL_MS=150

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_SHOP=helena-joy.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Option A: Dev Dashboard app (client credentials grant, token refreshed every 24 h). The app must be in the
# same organization as the store. Scopes: read_products, write_products, read_inventory, write_inventory,
# read_orders, write_orders, read_locations + protected customer data (name, email, phone, address).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: legacy custom app created from the admin (static token shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Secret used to sign webhooks (defaults to SHOPIFY_CLIENT_SECRET)
SHOPIFY_WEBHOOK_SECRET=
# Shopify location holding the web stock (gid://shopify/Location/...), see `npm run discover`
SHOPIFY_LOCATION_ID=
# Create Shopify products (as DRAFT) for ERP products marked "visible on website" that don't exist yet.
# Leave false until `npm run discover` shows the SKUs <-> refs match, otherwise you get duplicates.
SHOPIFY_CREATE_PRODUCTS=false
SHOPIFY_SIZE_OPTION_NAME=Taille
# Sized variant SKU = <ref><separator><size>, e.g. BAG-001/52
SHOPIFY_SIZE_SKU_SEPARATOR=/
# When the ERP hides a product: draft (unpublish) | zero_stock (stays visible, sold out)
SHOPIFY_HIDE_MODE=draft

# ─── Scheduling ───────────────────────────────────────────────────────────────
# ERP -> Shopify catalogue sync (stock, price, visibility). Keep false for Helena Joy: Shopify sells made to order
# without tracked stock, and no Jewely product is "visible on website", so turning it on would hide products.
SYNC_PRODUCTS=false
SYNC_POLL_INTERVAL_MINUTES=10
# Nightly full reconciliation (hour, Europe/Paris)
SYNC_FULL_HOUR=3
# Pieces held for a web order are released after N days if the ERP sale was never finalised
SYNC_HOLD_TTL_DAYS=30
